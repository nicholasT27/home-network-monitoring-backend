# Settings for the HOME AGENT (agent.php). Copy this file to ".env" in the folder where you run agent.php,
# on the computer at home. Both values are shown in the dashboard's "Home agent" panel: copy them from there.

AGENT_API_URL=https://your-backend.example.com/index.php
AGENT_KEY=your-personal-agent-key

# Scan at least this often, in seconds (a "Scan now" click in the dashboard scans straight away).
# AGENT_INTERVAL_S=120
