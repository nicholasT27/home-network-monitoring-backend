# Settings for the HOME AGENT (agent.php). Replace the two values below with the two lines shown in the
# dashboard's "Home agent" panel (click Copy there, then paste over these two lines), then save this file.
# Keep the file name exactly ".env".

AGENT_API_URL=https://your-backend.example.com/index.php
AGENT_KEY=your-personal-agent-key

# Scan at least this often, in seconds (a "Scan now" click in the dashboard scans straight away).
# AGENT_INTERVAL_S=120
