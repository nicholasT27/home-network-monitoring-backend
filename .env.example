# Copy this file to ".env" in the same folder as index.php and edit it.
# Do not commit the real .env file (it is in .gitignore). On a host with an environment-variables panel you can
# set the same names there instead.

# --- Database -------------------------------------------------------------------------------------------
# Leave these commented out to use a SQLite file (created automatically; fine for local testing).
# For a web host with MySQL, fill them in with the values from the host's control panel:
# DB_HOST=localhost
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASS=your_database_password

# --- Mode -----------------------------------------------------------------------------------------------
# agent = each user's home agent scans their network and uploads the result (use this on a web host)
# live  = this server scans the network it is connected to (backend running at home)
# demo  = simulated devices, to try the dashboard without a real network
SCAN_MODE=agent

# --- Security -------------------------------------------------------------------------------------------
# A long random sentence. It signs the login tokens, so keep it secret and do not use this example.
AUTH_SECRET=change-this-to-a-long-random-sentence
# Set to 0 to close sign-ups once everybody has registered.
ALLOW_REGISTRATION=1
# The address(es) of your dashboard, so the browser may call this API (comma separated, no trailing slash).
# http://localhost:5173 is always allowed for development.
ALLOWED_ORIGINS=https://your-dashboard.pages.dev

# --- Email alerts (optional) ----------------------------------------------------------------------------
# The account alert emails are sent FROM. For Gmail: turn on 2-Step Verification, then create an "app password".
# Users type only the address that should RECEIVE alerts, in the dashboard.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=ssl
# SMTP_USER=your.project.account@gmail.com
# SMTP_PASS=your16characterapppassword

# --- Default network range (optional) -------------------------------------------------------------------
# Each user sets their own range in the dashboard; this is only the starting value.
# SUBNET=192.168.0.0/24
